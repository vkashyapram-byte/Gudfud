{
  "rewrites": [
    {
      "source": "/v1/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/docs",
      "destination": "/api/index"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/v1/admin/worker/process",
      "schedule": "0 0 * * *"
    }
  ]
}
